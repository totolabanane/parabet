# Port sur lequel le serveur écoute
PORT=3000

# Clé secrète pour signer les tokens JWT (obligatoire)
# Mets une longue chaîne aléatoire, par ex générée avec :
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_moi_par_une_longue_chaine_aleatoire

# Code à saisir à l'inscription pour devenir admin (laisse vide pour désactiver)
ADMIN_CODE=

# Solde de départ offert à l'inscription
START_BALANCE=500

# Montant du bonus quotidien
DAILY_BONUS=50

# Montant minimum accepté pour un dépôt
DEPOSIT_MIN_AMOUNT=50

# Montant minimum pour une demande de retrait
WITHDRAW_MIN_AMOUNT=15000

# Bonus de parrainage : donné au parrain quand son filleul s'inscrit
REFERRAL_BONUS_REFERRER=100

# Bonus de parrainage : donné au filleul qui s'inscrit via un code
REFERRAL_BONUS_REFEREE=50

# URL de connexion à la base Postgres (Neon). Obligatoire.
# Récupère-la dans le dashboard Neon > ton projet > Connection string.
# Elle ressemble à :
# postgresql://user:password@ep-xxx-xxx.eu-central-1.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=
